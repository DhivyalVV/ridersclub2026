{
  "name": "ridersclub",
  "version": "0.1.0",
  "private": true,
  "description": "RidersClub — Enterprise Mobile-First Community Platform for Vehicle Owners and Riders",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build --concurrency=2",
    "dev": "turbo run dev",
    "dev:poc": "turbo run dev --filter=@ridersclub/api --filter=@ridersclub/community --filter=@ridersclub/shell",
    "dev:shell": "pnpm --filter @ridersclub/shell dev",
    "dev:community": "pnpm --filter @ridersclub/community dev",
    "dev:api": "pnpm --filter @ridersclub/api dev",
    "lint": "turbo run lint --concurrency=2",
    "typecheck": "turbo run typecheck --concurrency=2",
    "test": "turbo run test --concurrency=2",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @ridersclub/api prisma:generate",
    "db:migrate": "pnpm --filter @ridersclub/api prisma:migrate",
    "db:studio": "pnpm --filter @ridersclub/api prisma:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}

