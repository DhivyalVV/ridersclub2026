# ============================================================================
# RidersClub — Local Development Environment Variables (Template)
# Copy this file to .env for local development. Never commit real secrets.
# ============================================================================

NODE_ENV=development

# Database (Docker Compose PostgreSQL 16)
POSTGRES_USER=ridersclub
POSTGRES_PASSWORD=ridersclub_dev_password
POSTGRES_DB=ridersclub_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://ridersclub:ridersclub_dev_password@localhost:5432/ridersclub_db?schema=public"

# Backend API Server
API_PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS="http://localhost:5000,http://localhost:5001,http://localhost:5002,http://localhost:5003,http://localhost:5004,http://localhost:5005,http://localhost:5006"

# Authentication (Development Only — replace in production)
JWT_ACCESS_SECRET="dev-only-jwt-access-secret-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="dev-only-jwt-refresh-secret-change-in-production-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Micro-Frontend URLs (Local Dev Ports)
VITE_API_BASE_URL="http://localhost:4000/api/v1"
VITE_WS_BASE_URL="http://localhost:4000"
VITE_SHELL_URL="http://localhost:5000"
VITE_COMMUNITY_REMOTE_URL="http://localhost:5001/remoteEntry.js"
VITE_RIDES_REMOTE_URL="http://localhost:5002/remoteEntry.js"
VITE_HELP_REMOTE_URL="http://localhost:5003/remoteEntry.js"
VITE_MECHANICS_REMOTE_URL="http://localhost:5004/remoteEntry.js"
VITE_GARAGE_REMOTE_URL="http://localhost:5005/remoteEntry.js"
VITE_MARKETPLACE_REMOTE_URL="http://localhost:5006/remoteEntry.js"

