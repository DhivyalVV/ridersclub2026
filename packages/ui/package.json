{
  "name": "@ridersclub/ui",
  "version": "0.1.0",
  "private": true,
  "description": "RidersClub Shared Design System (Tailwind CSS, shadcn/ui, Profile Actions, Remote Error Boundary)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles/globals.css",
    "./tailwind.preset": "./tailwind.preset.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ridersclub/types": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
