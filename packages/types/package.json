{
  "name": "@ridersclub/types",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend-safe shared TypeScript types, enums, and API contracts for RidersClub",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@ridersclub/config": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

