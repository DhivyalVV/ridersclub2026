# ==============================================================================
# Stage 1: Builder — Build @ridersclub/types, @ridersclub/ui, and target MFE app
# Usage: docker build --build-arg APP_NAME=shell -f infrastructure/docker/Dockerfile.web .
# ==============================================================================
FROM node:20-alpine AS builder

ARG APP_NAME=shell
ARG VITE_API_BASE_URL=http://localhost:4000/api/v1
ARG VITE_COMMUNITY_REMOTE_URL=http://localhost:5001/remoteEntry.js
ARG VITE_RIDES_REMOTE_URL=http://localhost:5002/remoteEntry.js
ARG VITE_HELP_REMOTE_URL=http://localhost:5003/remoteEntry.js
ARG VITE_MECHANICS_REMOTE_URL=http://localhost:5004/remoteEntry.js
ARG VITE_GARAGE_REMOTE_URL=http://localhost:5005/remoteEntry.js
ARG VITE_MARKETPLACE_REMOTE_URL=http://localhost:5006/remoteEntry.js

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_COMMUNITY_REMOTE_URL=${VITE_COMMUNITY_REMOTE_URL}
ENV VITE_RIDES_REMOTE_URL=${VITE_RIDES_REMOTE_URL}
ENV VITE_HELP_REMOTE_URL=${VITE_HELP_REMOTE_URL}
ENV VITE_MECHANICS_REMOTE_URL=${VITE_MECHANICS_REMOTE_URL}
ENV VITE_GARAGE_REMOTE_URL=${VITE_GARAGE_REMOTE_URL}
ENV VITE_MARKETPLACE_REMOTE_URL=${VITE_MARKETPLACE_REMOTE_URL}

WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @ridersclub/types build && \
    pnpm --filter @ridersclub/ui build && \
    pnpm --filter "@ridersclub/${APP_NAME}" build

# ==============================================================================
# Stage 2: Production Nginx Static + Module Federation Host/Remote Server
# ==============================================================================
FROM nginx:1.27-alpine AS runner

ARG APP_NAME=shell
COPY infrastructure/docker/nginx-mfe.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/apps/${APP_NAME}/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]

